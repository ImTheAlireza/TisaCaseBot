# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-your-token-here

# The bot owner(s) — the ONLY role with full access (sudo).
# Comma-separated Telegram numeric user IDs. At least one is required.
# Get your own ID from @userinfobot or @getmyid_bot.
# NOTE: this is the "sudo" role. Regular admins are added/removed at runtime
# from the bot's menu (👥 مدیریت ادمین‌ها) and are stored in data/roles.json —
# NOT here.
SUDO_IDS=123456789

# Optional: logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Supervisor program name for the restart button (supervisorctl restart <name>)
SUPERVISOR_PROGRAM=tisabot

# Optional: path to supervisorctl if it's not on PATH
SUPERVISORCTL_BIN=supervisorctl

# Optional: supervisor config file supervisorctl should use.
# On Debian/Ubuntu this is usually /etc/supervisor/supervisord.conf.
# If unset, the bot auto-tries the common locations.
SUPERVISOR_CONF=

# Optional: supervisord server URL, e.g. unix:///var/run/supervisor.sock
# or http://localhost:9001. A bare socket path also works (unix:// is
# added automatically). Takes effect alongside/instead of SUPERVISOR_CONF.
SUPERVISOR_URL=

# Phone-post processor (optional)
ALBUM_WAIT_SECONDS=1.8
MAX_DOWNLOAD_MB=20
IMAGE_QUALITY=88
# How long a product flow may idle before it is closed and its temp files
# deleted (seconds). Default 900 = 15 minutes.
FLOW_TIMEOUT_SECONDS=900
# /tmp workspaces older than this many hours are swept hourly (crash leftovers).
# It covers both roots: the product flow's ZIPs and an order file downloaded but
# never answered.
TEMP_TTL_HOURS=12

# --- tracking-file converter (📦 تبدیل فایل کد رهگیری) ---------------------------
# A file bigger than this (MB) is refused before it is even downloaded: reading one
# would park the whole bot for everyone else in the chat.
MAX_FILE_MB=25
# Rows above this are refused with the number quoted in the message — never read
# halfway and never written as an empty "success".
MAX_ROWS=200000
# Reading one file may not take longer than this (seconds); the run is cancelled and
# the message says to split the file or send the system's text/PDF export instead.
PROCESS_TIMEOUT_SECONDS=120
# Accepted tracking-code lengths (Tisa exports 24 digits). EAN-13 / UPC are still
# accepted — as a warning, when their check digit adds up — so a product barcode
# pasted into the sheet does not silently become an order's tracking code.
BARCODE_LENGTHS=24

# --- sanity gates (anti-silent-corruption) ---------------------------------
# A price outside this range is treated as a misread (a weight, a date, an
# order code) and must be confirmed instead of published.
PRICE_MIN=1000
PRICE_MAX=500000000
# Model-less products are allowed by default (and publish without a model axis).
# Set yes only if every product must contain at least one detected model.
REQUIRE_MODELS=no
# AI timeout for the normalizer/extractor (seconds).
AI_TIMEOUT_SECONDS=30
# Optional OpenAI-compatible model for messy product captions
AI_BASE_URL=
AI_TOKEN=
AI_MODEL=

# Optional Telegram group/channel ID receiving the structured product card and the
# detailed WooCommerce publish trace (with a truthful dry-run/live label). Detailed
# traces are never sent to the user's private chat. Example group IDs start with -100.
LOG_CHAT_ID=

# VERBOSE_LOG=yes additionally sends the full step-by-step flow trace to that log chat
# (image handling, captions, extracted fields) after the product card. The publish HTTP
# trace goes to LOG_CHAT_ID either way; the complete local trace is also written to
# logs/bot.log.
VERBOSE_LOG=no

# Optional WooCommerce REST API connection test (shown under Ping).
WOOCOMMERCE_URL=https://example.com
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_API_VERSION=wc/v3

# WordPress Media API test (Application Password, not WooCommerce keys)
WORDPRESS_URL=https://example.com
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# Where the bot's small JSON stores live (roles, publish history, learned rules).
# Default is ./data inside the repo. On a shared host, point it OUT of the code
# directory — a redeploy or `git clean` would otherwise delete the shop's history:
#   TISA_DATA_DIR=/var/lib/tisaposttowp
# The test suite sets it to a temp dir for the same reason.
TISA_DATA_DIR=

# 🧪 Dry run: the whole publish path runs (payload, SKU selection, category lookup,
# media upload, variation batch) but the network is replaced by a fake, so
# NOTHING is written on the shop. Turn it on to rehearse a release, then off.
# The product card and «🧾 آخرین محصولات» mark such runs with 🧪 and store no
# product id, so a test never looks like a real publish.
TISA_DRY_RUN=no
